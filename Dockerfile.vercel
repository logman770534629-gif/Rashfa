# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS assets
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY vite.config.js tailwind.config.js postcss.config.js ./
COPY resources ./resources
RUN npm run build

FROM dunglas/frankenphp:1-php8.4-bookworm AS base
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions pdo_mysql mbstring intl zip bcmath gd opcache
WORKDIR /app

FROM base AS dependencies
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --prefer-dist --no-scripts --no-interaction --no-progress
COPY . .
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views bootstrap/cache \
    && composer dump-autoload --no-dev --optimize --no-interaction \
    && php artisan route:cache \
    && php artisan view:cache

FROM base AS runtime
COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --from=assets --chown=www-data:www-data /build/public/build /app/public/build
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile
COPY deploy/php-production.ini /usr/local/etc/php/conf.d/zz-rashfa.ini
# Preserve supplied public media as immutable assets; never ship session/log data.
COPY --chown=www-data:www-data storage/app/public/ /app/public/storage/
RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chmod +x /app/deploy/start-container.sh
ENV PORT=80 \
    VERCEL_CONTAINER=1 \
    APP_ENV=production \
    APP_DEBUG=false \
    APP_MAINTENANCE_DRIVER=file \
    RASHFA_PREVIEW_READ_ONLY=true \
    SESSION_DRIVER=cookie \
    SESSION_SECURE_COOKIE=true \
    SESSION_SAME_SITE=lax \
    SESSION_COOKIE=rashfa_preview_session \
    SESSION_LIFETIME=30 \
    CACHE_STORE=file \
    QUEUE_CONNECTION=sync \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=warning \
    DB_CONNECTION=mysql \
    MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt \
    XDG_CONFIG_HOME=/tmp/caddy-config \
    XDG_DATA_HOME=/tmp/caddy-data
USER www-data
EXPOSE 80
ENTRYPOINT ["/app/deploy/start-container.sh"]
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]

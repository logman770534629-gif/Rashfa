# Template only. Never commit a file containing actual credentials.
APP_NAME=Rashfa
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Vercel: leave unset to derive HTTPS URL from VERCEL_URL at startup.
APP_URL=
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_MAINTENANCE_DRIVER=file

RASHFA_PREVIEW_READ_ONLY=true
RASHFA_MEDIA_BASE_URL=
RASHFA_WHATSAPP_NUMBER=

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=juice_database
DB_USERNAME=
DB_PASSWORD=
# Use the system CA bundle for a publicly trusted MySQL certificate.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# Optional provider-specific public CA certificate, base64 encoded.
MYSQL_SSL_CA_BASE64=

SESSION_DRIVER=cookie
SESSION_COOKIE=rashfa_preview_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=30
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
FILESYSTEM_DISK=public
